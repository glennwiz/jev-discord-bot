# Copy to .env next to the binary for a local run (chmod 600); for systemd
# the same lines go in /etc/jev-discord-bot/env (see README "Deploy").
# Never commit either file.

# Bot token of the dedicated Jev test application (not the WhiteMage/DarkMage bots).
DISCORD_TOKEN=
# Numeric id of the guild where /jev is registered.
DISCORD_GUILD_ID=
# TypeSafe API key (starts with apikey_), from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional.
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_TIMEOUT_SECS=20
