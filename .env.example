# Copy to .env on the test box (chmod 600). Never commit .env.

# Bot token of the dedicated Jev test application (not the WhiteMage/DarkMage bots).
DISCORD_TOKEN=
# Numeric id of the test guild where /jev is registered.
DISCORD_GUILD_ID=
# jevmodel.org API key (starts with sk-), from Dashboard -> API keys.
JEVMODEL_API_KEY=

# Optional.
# JEV_BASE_URL=https://jevmodel.org
# JEV_TIMEOUT_SECS=20
