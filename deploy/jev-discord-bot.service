# /etc/systemd/system/jev-discord-bot.service
#
# Runs the bot as the dedicated, login-less user `jevbot`. Secrets live only
# in /etc/jev-discord-bot/env (root:jevbot, 0640) - never in this file, the
# binary, Git or the journal. Install steps: README.md "Deploy".

[Unit]
Description=Jev Discord bot (/jev choice, score, noul)
Documentation=file:///opt/jev-discord-bot/README.md
Wants=network-online.target
After=network-online.target
# At most 5 starts in 5 minutes, then stay failed (these are [Unit] keys).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jevbot
Group=jevbot
EnvironmentFile=/etc/jev-discord-bot/env
ExecStart=/opt/jev-discord-bot/jev-discord-bot
# Empty, private working dir, so the bot's .env lookup finds nothing there.
StateDirectory=jev-discord-bot
WorkingDirectory=/var/lib/jev-discord-bot

Restart=on-failure
RestartSec=5
# Config errors exit 2: restarting cannot fix them, so don't loop on them.
RestartPreventExitStatus=2

# Graceful stop: SIGTERM closes the gateway and drains in-flight replies for
# up to 15 s (DRAIN_TIMEOUT in src/main.rs); keep this above that.
KillSignal=SIGTERM
TimeoutStopSec=30

# stderr goes to the journal: `journalctl -u jev-discord-bot`.
StandardOutput=journal
StandardError=journal

# Hardening. The bot only needs outbound HTTPS/WSS and DNS.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
# Resident size is a few MB; the cap protects co-located services.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
